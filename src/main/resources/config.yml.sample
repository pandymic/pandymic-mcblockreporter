# Configuration for the Pandymic McBlockReporter plugin
apiUrl: "http://localhost:48081/api/v1"

# See https://github.com/pandymic/pandymic-mcservice for the web service.

reportEndpoint: "/report"
# Configuration for monitored blocks. Which blocks are monitored is a
# registry owned by the web service, not this file -- register a block via
# the in-game /registerblockmonitor command, a REST call to registerEndpoint,
# or the service's Web UI. This plugin fetches the current registry from
# listEndpoint on enable and again every refreshIntervalSeconds.
monitoredBlocks:
  listEndpoint: "/blocks"
  registerEndpoint: "/blocks"
  refreshIntervalSeconds: 30
  method: "PUT"
  endpoint: "/monitor"
  update:
      method: "PUT"
      endpoint: "/monitor"
  batch:
      method: "POST"
      endpoint: "/monitor"

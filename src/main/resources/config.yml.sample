# Configuration for the Pandymic McBlockReporter plugin
apiUrl: "http://localhost:48081/api/v1"

# See https://github.com/pandymic/pandymic-mcservice for the web service.

reportEndpoint: "/report"
# Configuration for monitored blocks. Which blocks are monitored is a
# registry owned by the web service, not this file -- register a block via
# the in-game /registerblockmonitor command, a REST call to registerEndpoint,
# or the service's Web UI. This plugin fetches the current registry from
# listEndpoint on enable and again every refreshIntervalSeconds.
monitoredBlocks:
  listEndpoint: "/blocks"
  registerEndpoint: "/blocks"
  refreshIntervalSeconds: 30
  method: "PUT"
  endpoint: "/monitor"
  update:
      method: "PUT"
      endpoint: "/monitor"
  batch:
      method: "POST"
      endpoint: "/monitor"

# Rail network scanning (/scanrailnetwork). The scan result (track
# positions/types/junctions) is POSTed here in one shot once a scan finishes.
railNetworks:
  ingestEndpoint: "/rail-networks/ingest"
  # Safety cap on how many rail blocks a single scan will traverse before
  # stopping early (truncated: true in the result) rather than continuing
  # indefinitely. Configurable specifically so raising it for a larger
  # network is a config edit + server restart, not a plugin rebuild.
  maxNodes: 50000

# Landmarks (/registerlandmark). A named point, registered once -- unlike
# monitored blocks, there's no ongoing state to track or report.
landmarks:
  registerEndpoint: "/landmarks"
